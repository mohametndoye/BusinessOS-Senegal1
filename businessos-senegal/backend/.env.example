PORT=4000
JWT_SECRET=change-moi-en-production-avec-une-longue-chaine-aleatoire
CORS_ORIGIN=http://localhost:5173

# URL publique du frontend (utilisée pour les redirections après paiement Wave/Orange Money)
FRONTEND_URL=http://localhost:5173
# URL publique de cette API (utilisée pour les webhooks de paiement, ex: https://votre-api.onrender.com)
BACKEND_URL=http://localhost:4000

# --- Wave Checkout API (https://docs.wave.com/checkout) ---
# Laissez vide pour fonctionner en mode démonstration (simulation de paiement sans clé réelle).
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=

# --- PayDunya (agrégateur utilisé pour Orange Money / Free Money / Wizall) ---
# Compte gratuit sur https://paydunya.com — clés disponibles dans votre espace marchand.
# Laissez vide pour fonctionner en mode démonstration.
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_MODE=test

# --- Compte administrateur (voir: npm run create-admin) ---
ADMIN_NAME=Équipe BusinessOS
ADMIN_EMAIL=admin@businessos.sn
ADMIN_PASSWORD=change-moi
